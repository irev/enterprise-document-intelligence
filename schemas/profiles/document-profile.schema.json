{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Document Profile",
  "type":"object",
  "required":["profile_id","version","document_type","fields"],
  "properties":{
    "profile_id":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "document_type":{"type":"string","minLength":1},
    "document_subtype":{"type":["string","null"]},
    "fields":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["name","data_type","document_required"],
        "properties":{
          "name":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
          "data_type":{"enum":["string","date","decimal","integer","boolean","object","array"]},
          "document_required":{"type":"boolean"},
          "normalization":{"type":["string","null"]},
          "high_risk":{"type":"boolean","default":false}
        },
        "additionalProperties":false
      }
    },
    "validation_profile":{"type":["string","null"]}
  },
  "additionalProperties":false
}
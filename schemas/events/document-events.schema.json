{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Document Intelligence Event",
  "type":"object",
  "required":["event_id","event_type","event_version","occurred_at","tenant_id","document_id","correlation_id"],
  "properties":{
    "event_id":{"type":"string","minLength":1},
    "event_type":{"enum":["document.received","document.processing_started","document.classified","document.extracted","document.validated","document.review_requested","document.review_completed","document.processing_failed","document.completed"]},
    "event_version":{"type":"string"},
    "occurred_at":{"type":"string","format":"date-time"},
    "tenant_id":{"type":"string"},
    "document_id":{"type":"string"},
    "correlation_id":{"type":"string"},
    "causation_id":{"type":["string","null"]},
    "data":{"type":"object"}
  },
  "additionalProperties":false
}
{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Deterministic Rule Set",
  "description":"Declarative policy contract. Implementations must use an allow-listed expression language; arbitrary code execution is forbidden.",
  "type":"object",
  "required":["rule_set_id","version","scope","rules"],
  "properties":{
    "rule_set_id":{"type":"string"},
    "version":{"type":"string"},
    "scope":{"enum":["DOCUMENT","BUNDLE","BUSINESS_REQUIREMENT"]},
    "rules":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["rule_id","when","assert","finding"],
        "properties":{
          "rule_id":{"type":"string"},
          "description":{"type":["string","null"]},
          "when":{"type":"object","description":"Typed, allow-listed condition AST."},
          "assert":{"type":"object","description":"Typed, allow-listed assertion AST."},
          "finding":{
            "type":"object",
            "required":["code","severity"],
            "properties":{
              "code":{"type":"string"},
              "severity":{"enum":["INFO","WARNING","ERROR","BLOCKING"]},
              "message_key":{"type":"string"}
            },
            "additionalProperties":false
          }
        },
        "additionalProperties":false
      }
    }
  },
  "additionalProperties":false
}
{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/schemas/policies/rule-set-v2.schema.json",
  "title":"Deterministic Rule Set v2",
  "type":"object",
  "required":["rule_set_id","version","language_version","scope","rules"],
  "properties":{
    "rule_set_id":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "language_version":{"const":"1.0"},
    "scope":{"enum":["DOCUMENT","BUNDLE","BUSINESS_REQUIREMENT"]},
    "rules":{"type":"array","items":{
      "type":"object","required":["rule_id","when","assert","finding"],
      "properties":{
        "rule_id":{"type":"string","minLength":1},
        "description":{"type":["string","null"]},
        "when":{"$ref":"expression.schema.json"},
        "assert":{"$ref":"expression.schema.json"},
        "finding":{"type":"object","required":["code","severity"],"properties":{
          "code":{"type":"string","minLength":1},
          "severity":{"enum":["INFO","WARNING","ERROR","BLOCKING"]},
          "message_key":{"type":["string","null"]}
        },"additionalProperties":false}
      },"additionalProperties":false
    }}
  },"additionalProperties":false
}
{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/schemas/conformance/test-vector.schema.json",
  "title":"Conformance Test Vector",
  "type":"object",
  "required":["vector_id","capability","requirement_refs","input","expected"],
  "properties":{
    "vector_id":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9._-]+$"},
    "version":{"type":"string","default":"1"},
    "capability":{"enum":["CORE","REVIEW","BUNDLE","POLICY","EVENTS","SEGMENTATION","DATASET","API"]},
    "requirement_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "preconditions":{"type":"array","items":{"type":"string"}},
    "input":{},
    "expected":{},
    "comparison":{"enum":["EXACT","SUBSET","SEMANTIC","PREDICATE"]},
    "notes":{"type":["string","null"]}
  },"additionalProperties":false
}
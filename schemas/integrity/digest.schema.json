{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/schemas/integrity/digest.schema.json",
  "title":"Integrity Digest",
  "type":"object",
  "required":["algorithm","digest"],
  "properties":{
    "algorithm":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},
    "digest":{"type":"string","minLength":1},
    "scope":{"enum":["SOURCE_BYTES","DERIVED_ARTIFACT","CANONICAL_PAYLOAD"]},
    "canonicalization":{"type":["string","null"]}
  },"additionalProperties":false
}
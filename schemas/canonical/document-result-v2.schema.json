{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/schemas/canonical/document-result-v2.schema.json",
  "title":"Canonical Document Result v2",
  "type":"object",
  "required":["document_id","schema_version","source","context","classification","entities","validation","provenance"],
  "properties":{
    "document_id":{"type":"string","minLength":1},
    "schema_version":{"const":"2.0"},
    "source":{"$ref":"#/$defs/source"},
    "context":{"$ref":"#/$defs/context"},
    "classification":{"$ref":"#/$defs/classification"},
    "entities":{"type":"object","additionalProperties":{"$ref":"#/$defs/field"}},
    "quality":{"type":"object","additionalProperties":true},
    "validation":{"$ref":"#/$defs/validation"},
    "provenance":{"type":"object","additionalProperties":true},
    "review":{"type":"object","additionalProperties":true},
    "audit":{"type":"object","additionalProperties":true}
  },
  "additionalProperties":false,
  "$defs":{
    "source":{"type":"object","required":["filename","mime_type","integrity"],"properties":{
      "filename":{"type":"string"},"mime_type":{"type":"string"},
      "integrity":{"type":"object","required":["algorithm","digest"],"properties":{"algorithm":{"type":"string"},"digest":{"type":"string"}},"additionalProperties":false},
      "size_bytes":{"type":"integer","minimum":0},"page_count":{"type":"integer","minimum":1}
    },"additionalProperties":false},
    "context":{"type":"object","required":["tenant_id"],"properties":{"tenant_id":{"type":"string","minLength":1},"business_domain":{"type":["string","null"]},"process":{"type":["string","null"]}},"additionalProperties":false},
    "classification":{"type":"object","required":["family","type","confidence","model_version"],"properties":{"family":{"type":"string"},"type":{"type":"string"},"subtype":{"type":["string","null"]},"confidence":{"type":"number","minimum":0,"maximum":1},"model_version":{"type":"string"}},"additionalProperties":false},
    "evidence":{"type":"object","required":["page","coordinate_space"],"properties":{
      "page":{"type":"integer","minimum":1},
      "text":{"type":["string","null"]},
      "bounding_box":{"type":["array","null"],"prefixItems":[{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1}],"minItems":4,"maxItems":4},
      "coordinate_space":{"const":"NORMALIZED_TOP_LEFT_XYXY"},
      "source_rotation_degrees":{"type":"integer","enum":[0,90,180,270]}
    },"additionalProperties":false},
    "field":{"oneOf":[
      {"type":"object","required":["state","raw_value","normalized_value","confidence","evidence"],"properties":{
        "state":{"const":"PRESENT"},"raw_value":{},"normalized_value":{},"confidence":{"type":"number","minimum":0,"maximum":1},
        "evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},
        "extractor":{"type":"object","additionalProperties":true}
      },"additionalProperties":false},
      {"type":"object","required":["state"],"properties":{
        "state":{"enum":["NOT_PRESENT","ILLEGIBLE","AMBIGUOUS","NOT_APPLICABLE"]},
        "candidates":{"type":"array","items":{"type":"object","properties":{"raw_value":{},"normalized_value":{},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}},"additionalProperties":false}},
        "reason_code":{"type":["string","null"]}
      },"additionalProperties":false}
    ]},
    "finding":{"type":"object","required":["code","severity","source"],"properties":{"code":{"type":"string"},"severity":{"enum":["INFO","WARNING","ERROR","BLOCKING"]},"message":{"type":["string","null"]},"source":{"type":"string"},"rule_version":{"type":["string","null"]},"documents":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "validation":{"type":"object","required":["status","findings"],"properties":{"status":{"enum":["VALID","REVIEW_REQUIRED","INVALID","UNSUPPORTED"]},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}}},"additionalProperties":false}
  }
}
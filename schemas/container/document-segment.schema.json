{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/schemas/container/document-segment.schema.json",
  "title":"Document Segment",
  "type":"object",
  "required":["segment_id","source_document_id","page_ranges","status"],
  "properties":{
    "segment_id":{"type":"string"},"source_document_id":{"type":"string"},
    "page_ranges":{"type":"array","minItems":1,"items":{"type":"object","required":["start","end"],"properties":{"start":{"type":"integer","minimum":1},"end":{"type":"integer","minimum":1}},"additionalProperties":false}},
    "status":{"enum":["DETECTED","CONFIRMED","REJECTED"]},
    "classification_hint":{"type":["object","null"],"additionalProperties":true},
    "provenance":{"type":"object","additionalProperties":true}
  },"additionalProperties":false
}
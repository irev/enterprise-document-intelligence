{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Document Annotation",
  "type":"object",
  "required":["document_id","taxonomy_version","labels","fields","annotation"],
  "properties":{
    "document_id":{"type":"string"},
    "taxonomy_version":{"type":"string"},
    "labels":{
      "type":"object",
      "required":["family","type"],
      "properties":{"family":{"type":"string"},"type":{"type":"string"},"subtype":{"type":["string","null"]}},
      "additionalProperties":false
    },
    "fields":{
      "type":"object",
      "additionalProperties":{
        "type":"object",
        "required":["state"],
        "properties":{
          "state":{"enum":["PRESENT","NOT_PRESENT","ILLEGIBLE","AMBIGUOUS","NOT_APPLICABLE"]},
          "raw_value":{},
          "normalized_value":{},
          "evidence":{
            "type":"array",
            "items":{
              "type":"object",
              "required":["page"],
              "properties":{
                "page":{"type":"integer","minimum":1},
                "text":{"type":["string","null"]},
                "bounding_box":{"type":["array","null"],"items":{"type":"number"},"minItems":4,"maxItems":4}
              },
              "additionalProperties":false
            }
          }
        },
        "additionalProperties":false
      }
    },
    "annotation":{
      "type":"object",
      "required":["status","version"],
      "properties":{
        "status":{"enum":["DRAFT","REVIEWED","VERIFIED"]},
        "version":{"type":"string"},
        "annotator_id":{"type":["string","null"]},
        "reviewer_id":{"type":["string","null"]},
        "notes":{"type":["string","null"]}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}